#!/bin/bash
# Verify the targeting rule actually routes premium → Sonnet and free → Haiku.
set -euo pipefail

probe() {
  local plan="$1"
  curl -fsS "http://localhost:3333/api/model-info?plan=${plan}" | jq -r '.model'
}

PREMIUM_MODEL=$(probe premium)
FREE_MODEL=$(probe free)

if [[ "$PREMIUM_MODEL" != *"sonnet"* ]]; then
  echo "FAIL: premium tier should route to a sonnet model, got: $PREMIUM_MODEL" >&2
  exit 1
fi

if [[ "$FREE_MODEL" != *"haiku"* ]]; then
  echo "FAIL: free tier should route to a haiku model, got: $FREE_MODEL" >&2
  exit 1
fi

echo "OK: premium=$PREMIUM_MODEL · free=$FREE_MODEL"
