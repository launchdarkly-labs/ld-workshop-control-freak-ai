#!/bin/bash
#
# Verify the Config's serving variation has reverted to the safe default
# (a haiku-named variation) for premium contexts.
#
set -euo pipefail

PROBE=$(curl -fsS "http://localhost:3333/api/model-info?plan=premium" | jq -r '.model')

if [[ "$PROBE" == *"haiku"* ]]; then
  echo "OK: premium tier is being served a haiku variation ($PROBE) — rollback fired."
  exit 0
fi

echo "FAIL: premium tier still served $PROBE — rollback has not fired yet." >&2
echo "Re-run trigger-bad-scenario.sh if needed; the judge needs enough samples." >&2
exit 1
