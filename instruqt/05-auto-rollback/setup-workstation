#!/bin/bash
# Ch4 setup — make sure the bad-scenario script is executable and the app
# is still up. The judge monitoring rule is created by the learner in the UI.
set -euo pipefail

REPO_ROOT="/opt/control-freak-ai"

chmod +x "${REPO_ROOT}/scripts/trigger-bad-scenario.sh"

# Belt-and-suspenders: confirm port 3333 is responsive.
for _ in {1..15}; do
  if curl -fsS http://localhost:3333/healthz > /dev/null; then
    exit 0
  fi
  sleep 1
done

echo "ToggleWear is not responding on port 3333 — restarting service." >&2
service togglewear restart || true
exit 0
