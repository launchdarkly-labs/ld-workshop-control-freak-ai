#!/bin/bash
#
# track_scripts/setup-workstation — runs once when the Instruqt lab starts.
#
# Responsibilities:
#   1. Wait for the host bootstrap to finish.
#   2. Provision the student's LD project via terraform-ld-student (from the
#      shared VM image) and capture the project key.
#   3. Run scripts/bootstrap-ld.sh to create the segment, Config, and variations.
#   4. Sed real credentials into app/.env.
#   5. (Re)start the togglewear service so it picks up the new env.
#
set -euo pipefail

REPO_ROOT="/opt/ld/ld-workshop-control-freak-ai"

# 1. Wait for instruqt bootstrap
until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
  echo "Waiting for instruqt bootstrap to complete..."
  sleep 1
done

# 2. Provision student LD project. The terraform-ld-student module is baked
#    into the VM image and produces a student-scoped project per sandbox.
cd /opt/ld/terraform-ld-student
echo "sandbox_id = \"${_SANDBOX_ID}\"" > terraform.tfvars
terraform apply -auto-approve

LD_PROJECT_KEY="$(terraform output -json | jq -r '.students.value[0].project_key')"
export LD_PROJECT_KEY

# Persist for later shells
{
  echo ""
  echo "export LD_PROJECT_KEY=\"${LD_PROJECT_KEY}\""
} | tee -a ~/.bashrc ~/.profile > /dev/null

# 3. Bootstrap LD resources for this track. The bootstrap script creates the
#    premium-users segment only — the AgentControl Config and its variations
#    are created by the learner in Ch01 (Otto is Born) and Ch02 (Model Routing).
"${REPO_ROOT}/scripts/bootstrap-ld.sh"

# Source the env that bootstrap-ld.sh emitted (LD_SDK_KEY etc.)
# shellcheck disable=SC1091
source /tmp/control-freak-env
{
  echo "export LD_SDK_KEY=\"${LD_SDK_KEY}\""
  echo "export LD_ENVIRONMENT_KEY=\"${LD_ENVIRONMENT_KEY}\""
} | tee -a ~/.bashrc ~/.profile > /dev/null

# 4. Sed real values into the app .env so the togglewear service can boot.
APP_ENV="${REPO_ROOT}/app/.env"
if [ ! -f "$APP_ENV" ]; then
  cp "${REPO_ROOT}/app/.env.example" "$APP_ENV"
fi
sed -i "s|^LD_SDK_KEY=.*|LD_SDK_KEY=${LD_SDK_KEY}|g"           "$APP_ENV"
sed -i "s|^LD_PROJECT_KEY=.*|LD_PROJECT_KEY=${LD_PROJECT_KEY}|g" "$APP_ENV"
sed -i "s|^AWS_REGION=.*|AWS_REGION=${AWS_REGION}|g"             "$APP_ENV"

# 5. Restart the service. `restart` only sends SIGHUP which the app ignores,
#    so we stop+start to force a fresh process with the new env.
service togglewearcf stop || true
service togglewearcf start
