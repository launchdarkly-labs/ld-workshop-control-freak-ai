#!/bin/bash
#
# Verify that the learner kicked off an eval run that has reached `completed`.
#
set -euo pipefail

AI_CONFIG_KEY="otto-assistant"
LD_API="${LD_API:-https://app.launchdarkly.com/api/v2}"
AG_TOKEN="${LAUNCHDARKLY_AG_API_TOKEN:-$LAUNCHDARKLY_ACCESS_TOKEN}"

: "${LD_PROJECT_KEY:?LD_PROJECT_KEY must be set}"

# NOTE: verify the eval-runs collection endpoint against
# https://launchdarkly.com/docs/home/ai-configs/evals
RUNS=$(curl -fsS -X GET \
  "${LD_API}/projects/${LD_PROJECT_KEY}/ai-configs/${AI_CONFIG_KEY}/eval-runs" \
  -H "Authorization: ${AG_TOKEN}")

COMPLETED=$(echo "$RUNS" | jq -r '[.items[]? | select(.status == "completed")] | length')

if [ "${COMPLETED:-0}" -ge 1 ]; then
  echo "OK: $COMPLETED completed eval run(s) found on $AI_CONFIG_KEY."
  exit 0
fi

echo "FAIL: no completed eval runs on $AI_CONFIG_KEY yet." >&2
exit 1
